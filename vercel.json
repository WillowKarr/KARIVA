{
  "trailingSlash": true,
  "rewrites": [
    { "source": "/design/:slug", "destination": "/design/index.html" },
    { "source": "/art/:slug", "destination": "/art/index.html" }
  ],
  "headers": [
    { "source": "/src/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
